{
  "name": "literate-reviews",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev:receiver": "wrangler dev -c wrangler.receiver.toml",
    "dev:consumer": "wrangler dev -c wrangler.consumer.toml",
    "deploy:receiver": "wrangler deploy -c wrangler.receiver.toml",
    "deploy:consumer": "wrangler deploy -c wrangler.consumer.toml",
    "deploy": "pnpm run deploy:receiver && pnpm run deploy:consumer",
    "build:receiver": "wrangler deploy --dry-run -c wrangler.receiver.toml",
    "build:consumer": "wrangler deploy --dry-run -c wrangler.consumer.toml",
    "build": "pnpm run build:receiver && pnpm run build:consumer",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.8",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "langsmith": "^0.9.0",
    "octokit": "^5.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
